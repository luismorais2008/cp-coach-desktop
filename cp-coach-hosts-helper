def set_strict(uid, allowed, addresses, unresolved):
    nft_run(['-f', '-'], nft_rules(uid, addresses, nft_exists()))
    atomic_write(STRICT_STATE, json.dumps(dict(uid=uid, allowed=allowed, addresses=addresses, unresolved=unresolved, fingerprint=nft_fingerprint())).encode(), 0o600)


def refresh_strict(uid, allowed):
    def resolve(host):
        try:
            addresses = {item[4][0] for item in socket.getaddrinfo(host, None, type=socket.SOCK_STREAM)}
            return host, sorted(addresses)
        except socket.gaierror:
            return host, []
    hosts = sorted({host.removeprefix('*.') for host in allowed})
    with ThreadPoolExecutor(max_workers=16) as pool:
        resolved = list(pool.map(resolve, hosts))
    addresses = sorted({address for _, values in resolved for address in values})
    unresolved = [host for host, values in resolved if not values]
    set_strict(uid, allowed, addresses, unresolved)


def strict_status(uid):
    state = load_strict_state()
    active = bool(state and state['uid'] == uid and nft_exists() and nft_fingerprint() == state['fingerprint'])
    allowed = validate_allowed(state['allowed']) if state and state['uid'] == uid else []
    hosts = BLOCK in Path('/etc/hosts').read_text()
    policies = policy_status(allowed) if allowed else False
    reason = '' if active else 'Firewall nftables ausente ou alterada.'
    if not hosts or not policies:
        reason += ' Hosts ou políticas ausentes.'
    if state and state.get('unresolved'):
        reason += ' Sem DNS para: ' + ', '.join(state['unresolved'])
    return dict(active=active and hosts and policies, nft=active, hosts=hosts, policies=policies, allowed=allowed, uid=uid, reason=reason.strip())


def remove_strict():
    if nft_exists():
        nft_run(['delete', 'table', 'inet', 'cp_coach'])
    safe_path(STRICT_STATE)
    STRICT_STATE.unlink(missing_ok=True)


def root_json(path, default):
    safe_path(path)
    return json.loads(path.read_text()) if path.exists() else default


def restriction_event(state, how):
    events = root_json(EMERGENCY_JOURNAL, [])
    events.append(dict(id=uuid.uuid4().hex, session=state['id'], uid=state['uid'], start=state['start'], deadline=state['deadline'], mode=state.get('mode', 'practice-no-ai'), strict=state['strict'], time=time.time(), how=how))
    atomic_write(EMERGENCY_JOURNAL, json.dumps(events[-256:]).encode(), 0o600)


def record_restriction(uid, value, strict):
    now = time.time()
    if value is None:
        value = dict(id=uuid.uuid4().hex, start=now, deadline=now + 86400)
    if not isinstance(value, dict) or not re.fullmatch('[0-9a-f]{32}', str(value.get('id', ''))):
        raise ValueError('Identificador de sessão inválido.')
    for key in ('start', 'deadline'):
        number = value.get(key)
        if isinstance(number, bool) or not isinstance(number, (int, float)) or not math.isfinite(number):
            raise ValueError('Prazo de sessão inválido.')
    if not value['start'] <= now + 60 or not now - 60 < value['deadline'] <= now + 604860 or value['deadline'] <= value['start']:
        raise ValueError('Prazo de sessão inválido.')
    mode = value.get('mode', 'practice-no-ai')
    if mode not in ('contest', 'practice-no-ai'):
        raise ValueError('Modo de restrição inválido.')
    previous = root_json(RESTRICTION_STATE, None)
    if previous and previous['id'] != value['id'] and previous['deadline'] > now:
        restriction_event(previous, 'restriction replaced')
    state = dict(id=value['id'], start=value['start'], deadline=value['deadline'], uid=uid, strict=strict, mode=mode)
    atomic_write(RESTRICTION_STATE, json.dumps(state).encode(), 0o600)


def end_restriction(how, normal_id=None, interrupted=False):
    state = root_json(RESTRICTION_STATE, None)
    if state:
        if normal_id is not None and (normal_id != state['id'] or caller_uid() != state['uid']):
            raise ValueError('A sessão não corresponde à restrição ativa.')
        if interrupted or (normal_id is None and time.time() < state['deadline']):
            restriction_event(state, how)
        RESTRICTION_STATE.unlink()


def watch_firewall(uid):
    state = root_json(RESTRICTION_STATE, None)
    if not state or state['uid'] != uid or not state['strict']:
        return
    process = subprocess.Popen([NFT, 'monitor', 'ruleset'], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, bufsize=0)
    try:
        while process.poll() is None:
            ready, _, _ = select.select([sys.stdin.buffer, process.stdout], [], [], 1)
            if sys.stdin.buffer in ready:
                return
            if process.stdout in ready:
                line = process.stdout.readline()
                if not line:
                    return
                if b'cp_coach' in line:
                    print('changed', flush=True)
    finally:
        process.terminate()
        process.wait(timeout=3)


def main():
    verbs = ('apply', 'apply-strict', 'refresh', 'remove', 'finish', 'interrupt', 'journal', 'watch', 'status', 'strict-status')
    if len(sys.argv) != 2 or sys.argv[1] not in verbs:
        raise ValueError('Uso: cp-coach-hosts-helper ' + '|'.join(verbs))
    action = sys.argv[1]
    if action == 'status':
        with open('/etc/hosts') as source:
            hosts = BLOCK in source.read()
        policies = policy_status()
        print(json.dumps({'active': hosts and policies, 'hosts': hosts, 'policies': policies}))
        return
    if os.geteuid() != 0:
        raise PermissionError('São necessários privilégios de administrador')
    if action == 'journal':
        uid = caller_uid()
        state = root_json(RESTRICTION_STATE, None)
        events = root_json(EMERGENCY_JOURNAL, [])
        print(json.dumps(dict(active=state if state and state['uid'] == uid else None, events=[event for event in events if event['uid'] == uid])))
        return
    if action == 'watch':
        watch_firewall(caller_uid())
        return
    if action == 'strict-status':
        print(json.dumps(strict_status(caller_uid())))
        return
    allowed = None
    payload = None
    if action in ('apply', 'apply-strict', 'finish', 'interrupt'):
        body = b'' if sys.stdin.isatty() else sys.stdin.buffer.read(32769)
        if len(body) > 32768:
            raise ValueError('Lista permitida demasiado longa.')
        payload = json.loads(body) if body.strip() else None
    if action == 'apply-strict':
        allowed = validate_allowed(payload.get('allowed') if isinstance(payload, dict) else payload)
    if action in ('apply', 'apply-strict'):
        uid = caller_uid()
    fd = os.open('/run/cp-coach-hosts.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    with os.fdopen(fd, 'r+') as lock:
        lock_info = os.fstat(lock.fileno())
        if not stat.S_ISREG(lock_info.st_mode) or lock_info.st_uid != 0 or lock_info.st_mode & 0o022:
            raise ValueError('Ficheiro de bloqueio inseguro em /run/cp-coach-hosts.lock')
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ValueError('Outra operação CP Coach está em curso; tente novamente.') from None
        if action in ('apply', 'apply-strict'):
            record_restriction(uid, payload.get('restriction') if isinstance(payload, dict) else None, action == 'apply-strict')
        elif action in ('finish', 'interrupt'):
            if not isinstance(payload, dict) or not re.fullmatch('[0-9a-f]{32}', str(payload.get('id', ''))):
                raise ValueError('Identificador de sessão inválido.')
            end_restriction('monitor gap or missing block' if action == 'interrupt' else 'normal end', payload['id'], action == 'interrupt')
            action = 'remove'
        elif action == 'remove':
            end_restriction('helper remove')
        if action == 'refresh':
            uid = caller_uid()
            state = load_strict_state()
            if not state or state['uid'] != uid:
                raise ValueError('Nenhuma firewall deste utilizador para atualizar.')
            refresh_strict(uid, validate_allowed(state['allowed']))
            print(json.dumps(strict_status(uid)))
            return
        info = os.lstat('/etc/hosts')
        if not stat.S_ISREG(info.st_mode):
            raise ValueError('/etc/hosts não é um ficheiro regular')
        with open('/etc/hosts') as source:
            original = source.read()
        if action != 'apply-strict':
            remove_strict()
        noai = noai_hosts_block() if action == 'apply' else ''
        change_policies('apply' if action == 'apply-strict' else action, allowed)
        body = stripped(original)
        if action in ('apply', 'apply-strict'):
            body = body.rstrip('\n') + '\n' + BLOCK + noai
        fd, name = tempfile.mkstemp(prefix='.cp-coach-', dir='/etc')
        try:
            with os.fdopen(fd, 'w') as target:
                os.fchmod(target.fileno(), stat.S_IMODE(info.st_mode))
                os.fchown(target.fileno(), info.st_uid, info.st_gid)
                target.write(body)
                target.flush()
                os.fsync(target.fileno())
            os.replace(name, '/etc/hosts')
        finally:
            if os.path.exists(name):
                os.unlink(name)
        if action == 'apply-strict':
            set_strict(uid, allowed, [], [])
            refresh_strict(uid, allowed)
            print(json.dumps(strict_status(uid)))
        else:
            print(json.dumps({'active': action == 'apply'}))


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
