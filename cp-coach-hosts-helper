def validate_allowed(value):
    if isinstance(value, str):
        value = value.splitlines()
    if not isinstance(value, list) or not 1 <= len(value) <= 128:
        raise ValueError('Lista permitida: entre 1 e 128 nomes de hosts, um por linha.')
    result = set()
    for entry in value:
        if not isinstance(entry, str):
            raise ValueError('Cada entrada tem de ser um nome de host.')
        entry = entry.strip().lower()
        host = entry[2:] if entry.startswith('*.') else entry
        if not 1 <= len(host) <= 253 or '.' not in host or not re.fullmatch(r'[a-z][a-z0-9-]*', host.rsplit('.', 1)[-1]) or any(not re.fullmatch(r'[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?', label) for label in host.split('.')):
            raise ValueError('Host inválido: ' + entry + '. Usa só nomes, com *. opcional no início; sem IPs, protocolos ou caminhos.')
        try:
            ipaddress.ip_address(host)
        except ValueError:
            pass
        else:
            raise ValueError('Endereços IP não são permitidos: ' + entry)
        if host.replace('.', '').isdigit():
            raise ValueError('Endereços IP não são permitidos: ' + entry)
        result.add(entry)
    return sorted(result)


